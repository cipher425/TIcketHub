# ---------- Core ----------
NODE_ENV=development
PORT=5000
# MongoDB MUST be a replica set (transactions). MongoDB Atlas free tier (M0) works out of the box.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/tickethub?retryWrites=true&w=majority
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
ADMISSION_TOKEN_SECRET=change-me-another-long-random-string-32-chars
BCRYPT_ROUNDS=12
# 'lax' when frontend and API share a site (dev proxy / Vercel rewrite). 'none' if they are on different sites (requires COOKIE_SECURE=true)
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# ---------- Payments ----------
# 'mock' works without any account (also used for load tests). 'razorpay' uses Razorpay test mode.
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
MOCK_PAYMENT_SECRET=mock-secret-for-local-signatures

# ---------- Booking rules ----------
HOLD_DURATION_SECONDS=300
PAYMENT_GRACE_SECONDS=180
MAX_SEATS_PER_BOOKING=10
# Money is always in paise (1 INR = 100 paise)
CONVENIENCE_FEE_PER_TICKET=3000
TAX_RATE_BPS=1800

# ---------- Background jobs ----------
# Only ONE process should run scheduled jobs. Set false on extra API instances.
RUN_JOBS=true
HOLD_SWEEP_INTERVAL_SECONDS=30

# ---------- Security ----------
RATE_LIMIT_ENABLED=true

# =====================================================================
# Stage 3 switches. Leave these at defaults for Stage 1 behaviour.
# =====================================================================
# REDIS_URL=redis://localhost:6379
REDIS_URL=
# mongo | redis   - where seat holds live
RESERVATION_STORE=mongo
# inline | bullmq - how background jobs / notifications run
QUEUE_DRIVER=inline
# none | memory | redis - response caching for seat layouts / home page
CACHE_DRIVER=none
# memory | redis - rate limit counters
RATE_LIMIT_STORE=memory
# Socket.IO real-time seat updates
REALTIME_ENABLED=false
# Virtual waiting room for events flagged highDemand (requires Redis)
WAITING_ROOM_ENABLED=false
WAITING_ROOM_MAX_ACTIVE=200
WAITING_ROOM_ADMISSION_SECONDS=600
